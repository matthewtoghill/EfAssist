<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads EF's generated model snapshots for the Diagrams tab. A syntax-only parse:
         CSharpSyntaxTree.ParseText and a walk over the invocation chains. No MSBuildWorkspace, no
         Compilation, no semantic model, and no reference to the user's assemblies — so nothing here
         needs the target project to build. Do not add Microsoft.CodeAnalysis.Workspaces on the
         assumption a compilation is available; there isn't one. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

</Project>
