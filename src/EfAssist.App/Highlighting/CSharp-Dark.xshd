<?xml version="1.0" encoding="utf-8"?>
<!-- C# highlighting tuned for the Dark theme variant, for reading a migration's .cs file.

     There is a file per variant for the same reason as the SQL definitions: a HighlightingColor
     carries a literal colour, not a theme resource, so a theme switch can only be reflected by
     loading a different definition. See SyntaxHighlighting.

     Deliberately smaller than AvaloniaEdit's bundled CSharp-Mode.xshd. Migration files are generated
     code with a narrow vocabulary, so comments, strings, keywords, types and numbers cover them; the
     preprocessor and doc-comment machinery upstream carries would highlight nothing here. -->
<SyntaxDefinition name="CSharp-Dark" extensions=".cs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#6A9955" exampleText="// comment" />
	<Color name="String" foreground="#CE9178" exampleText="&quot;abc&quot;"/>
	<Color name="Types" foreground="#4EC9B0" exampleText="string name"/>
	<Color name="Digits" foreground="#B5CEA8" exampleText="3.1415"/>
	<Color name="Keywords" fontWeight="bold" foreground="#569CD6" exampleText="public class"/>

	<Property name="DocCommentMarker" value="///" />

	<RuleSet name="CommentMarkerSet">
		<Keywords fontWeight="bold" foreground="Red">
			<Word>TODO</Word>
			<Word>FIXME</Word>
		</Keywords>
		<Keywords fontWeight="bold" foreground="#E0E000">
			<Word>HACK</Word>
			<Word>UNDONE</Word>
		</Keywords>
	</RuleSet>

	<RuleSet>
		<Span color="Comment" ruleSet="CommentMarkerSet">
			<Begin>//</Begin>
		</Span>

		<Span color="Comment" ruleSet="CommentMarkerSet" multiline="true">
			<Begin>/\*</Begin>
			<End>\*/</End>
		</Span>

		<!-- Verbatim strings first: @"..." doubles its quotes rather than escaping with a
		     backslash, so the ordinary string rule would end one at the wrong place. -->
		<Span color="String" multiline="true">
			<Begin>@"</Begin>
			<End>"</End>
			<RuleSet>
				<!-- A doubled quote is an escaped quote. Consuming it here is what stops the End
				     above from matching the second half of the pair and ending the string early. -->
				<Span begin='""' end=""/>
			</RuleSet>
		</Span>

		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>

		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>

		<Keywords color="Keywords">
			<Word>abstract</Word>
			<Word>as</Word>
			<Word>base</Word>
			<Word>break</Word>
			<Word>case</Word>
			<Word>catch</Word>
			<Word>checked</Word>
			<Word>class</Word>
			<Word>const</Word>
			<Word>continue</Word>
			<Word>default</Word>
			<Word>delegate</Word>
			<Word>do</Word>
			<Word>else</Word>
			<Word>enum</Word>
			<Word>event</Word>
			<Word>explicit</Word>
			<Word>extern</Word>
			<Word>false</Word>
			<Word>finally</Word>
			<Word>fixed</Word>
			<Word>for</Word>
			<Word>foreach</Word>
			<Word>goto</Word>
			<Word>if</Word>
			<Word>implicit</Word>
			<Word>in</Word>
			<Word>interface</Word>
			<Word>internal</Word>
			<Word>is</Word>
			<Word>lock</Word>
			<Word>namespace</Word>
			<Word>new</Word>
			<Word>null</Word>
			<Word>operator</Word>
			<Word>out</Word>
			<Word>override</Word>
			<Word>params</Word>
			<Word>partial</Word>
			<Word>private</Word>
			<Word>protected</Word>
			<Word>public</Word>
			<Word>readonly</Word>
			<Word>ref</Word>
			<Word>return</Word>
			<Word>sealed</Word>
			<Word>sizeof</Word>
			<Word>stackalloc</Word>
			<Word>static</Word>
			<Word>struct</Word>
			<Word>switch</Word>
			<Word>this</Word>
			<Word>throw</Word>
			<Word>true</Word>
			<Word>try</Word>
			<Word>typeof</Word>
			<Word>unchecked</Word>
			<Word>unsafe</Word>
			<Word>using</Word>
			<Word>virtual</Word>
			<Word>volatile</Word>
			<Word>while</Word>
			<Word>async</Word>
			<Word>await</Word>
			<Word>var</Word>
			<Word>nameof</Word>
			<Word>record</Word>
			<Word>init</Word>
			<Word>get</Word>
			<Word>set</Word>
			<Word>value</Word>
		</Keywords>

		<!-- Built-in type names, coloured apart from the control-flow keywords so a migration's
		     column definitions stand out from its structure. -->
		<Keywords color="Types">
			<Word>bool</Word>
			<Word>byte</Word>
			<Word>char</Word>
			<Word>decimal</Word>
			<Word>double</Word>
			<Word>float</Word>
			<Word>int</Word>
			<Word>long</Word>
			<Word>object</Word>
			<Word>sbyte</Word>
			<Word>short</Word>
			<Word>string</Word>
			<Word>uint</Word>
			<Word>ulong</Word>
			<Word>ushort</Word>
			<Word>void</Word>
			<Word>dynamic</Word>
		</Keywords>

		<Rule color="Digits">
			\b0[xX][0-9a-fA-F]+|(\b\d+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?[fFdDmMuUlL]?
		</Rule>
	</RuleSet>
</SyntaxDefinition>
