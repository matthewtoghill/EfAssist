<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EfAssist.App.ViewModels"
        xmlns:core="using:EfAssist.Core"
        xmlns:app="using:EfAssist.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="640"
        x:Class="EfAssist.App.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Settings"
        Width="560" Height="640"
        MinWidth="480" MinHeight="480"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTiny}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Every section is a labelled block with the same rhythm, so the sizes are set once. -->
        <Style Selector="Border.section">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Above the tabs rather than inside Appearance, so switching tabs cannot hide the fact that
             a restart is owed. The colours are already saved; only the repaint is outstanding. -->
        <Border Grid.Row="0" Classes="caution" CornerRadius="4" Padding="12,10" Margin="0,0,0,12"
                IsVisible="{Binding Appearance.NeedsRestart}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Restart to apply the new colours" FontWeight="SemiBold" />
                    <TextBlock Classes="hint"
                               Text="Saved already. Avalonia cannot repaint a running app's colours, so they take effect on the next start." />
                </StackPanel>
                <Button Grid.Column="1" Content="Restart now" Classes="accent"
                        VerticalAlignment="Center" Command="{Binding RestartCommand}"
                        ToolTip.Tip="Unavailable while a command is running - a restart would kill it." />
            </Grid>
        </Border>

        <TabControl Grid.Row="1">

            <TabItem Header="Appearance">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,10,0,0">

                        <Border Classes="section">
                            <StackPanel>
                                <TextBlock Classes="group" Text="Theme" />

                                <TextBlock Classes="label" Text="Variant" />
                                <ComboBox ItemsSource="{Binding Appearance.Themes}"
                                          SelectedItem="{Binding Appearance.Theme}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Classes="hint"
                                           Text="Applies immediately. System follows the operating system, including changes made while the app is running." />

                                <TextBlock Classes="label" Text="Palette" />
                                <ComboBox ItemsSource="{Binding Appearance.Presets}"
                                          SelectedItem="{Binding Appearance.Preset}"
                                          HorizontalAlignment="Stretch">
                                    <!-- Member names, spaced: "HighContrast" is not a label. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:ThemePreset">
                                            <TextBlock Text="{Binding Converter={x:Static app:OutputConverters.SpacedName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="hint"
                                           Text="A starting point for the three colours below. Each palette has a light and a dark half, so a palette and System work together." />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="group" Text="Colours" VerticalAlignment="Center" />
                                    <!-- Two sets of colours, one per variant, so a System user can set both.
									     This picks which set the pickers below are editing, not which is showing. -->
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding Appearance.EditingDark}"
                                                  OffContent="Light" OnContent="Dark"
                                                  ToolTip.Tip="Which variant's colours these pickers edit." />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Background" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ColorPicker Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                                 HorizontalAlignment="Left"
                                                 Color="{Binding Appearance.Background}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Accent" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ColorPicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                                 HorizontalAlignment="Left"
                                                 Color="{Binding Appearance.Accent}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Text" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ColorPicker Grid.Row="2" Grid.Column="1"
                                                 HorizontalAlignment="Left"
                                                 Color="{Binding Appearance.Foreground}" />
                                </Grid>

                                <TextBlock Classes="hint" Margin="0,8,0,0"
                                           Text="Borders, panels, hover states and the accent's own lighter and darker shades are derived from these three. Errors and warnings keep their own colours so a failure always reads as one." />

                                <Button Content="Reset colours to palette defaults"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding Appearance.HasOverrides}"
                                        Command="{Binding Appearance.ResetColoursCommand}"
                                        ToolTip.Tip="Affects only the variant selected above." />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel>
                                <TextBlock Classes="group" Text="Preview" />

                                <!-- Painted from plain brushes rather than theme resources: it has to show the
								     palette being edited, which is not the one the window around it is using. -->
                                <Border CornerRadius="4" BorderThickness="1" Padding="12"
                                        Background="{Binding Appearance.Preview.Surface, Converter={x:Static app:OutputConverters.Brush}}"
                                        BorderBrush="{Binding Appearance.Preview.Border, Converter={x:Static app:OutputConverters.Brush}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="AddBlogUrl" FontWeight="SemiBold"
                                                   Foreground="{Binding Appearance.Preview.Text, Converter={x:Static app:OutputConverters.Brush}}" />
                                        <TextBlock Text="20260818140952_AddBlogUrl"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   FontSize="{DynamicResource AppFontSizeMono}"
                                                   Foreground="{Binding Appearance.Preview.MutedText, Converter={x:Static app:OutputConverters.Brush}}" />

                                        <Border CornerRadius="3" BorderThickness="1" Padding="8"
                                                Background="{Binding Appearance.Preview.Panel, Converter={x:Static app:OutputConverters.Brush}}"
                                                BorderBrush="{Binding Appearance.Preview.Border, Converter={x:Static app:OutputConverters.Brush}}">
                                            <TextBlock Text="Panels, lists and control fills"
                                                       Foreground="{Binding Appearance.Preview.Text, Converter={x:Static app:OutputConverters.Brush}}" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="3" Padding="12,6"
                                                    Background="{Binding Appearance.Preview.Accent, Converter={x:Static app:OutputConverters.Brush}}">
                                                <TextBlock Text="Selected"
                                                           Foreground="{Binding Appearance.Preview.OnAccent, Converter={x:Static app:OutputConverters.Brush}}" />
                                            </Border>
                                            <Border CornerRadius="3" BorderThickness="1" Padding="12,6"
                                                    Background="{Binding Appearance.Preview.Panel, Converter={x:Static app:OutputConverters.Brush}}"
                                                    BorderBrush="{Binding Appearance.Preview.Border, Converter={x:Static app:OutputConverters.Brush}}">
                                                <TextBlock Text="Button"
                                                           Foreground="{Binding Appearance.Preview.Text, Converter={x:Static app:OutputConverters.Brush}}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="hint" Margin="0,8,0,0"
                                           Text="What the next start will look like, derived by the same rules the real theme uses." />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel>
                                <TextBlock Classes="group" Text="Font size" />

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Interface" VerticalAlignment="Center"
                                               Margin="0,0,12,0" MinWidth="70" />
                                    <Slider Grid.Column="1" VerticalAlignment="Center"
                                            Minimum="{x:Static vm:SettingsViewModel.MinFontSize}"
                                            Maximum="{x:Static vm:SettingsViewModel.MaxFontSize}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Appearance.UiFontSize}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="28"
                                               TextAlignment="Right"
                                               Text="{Binding Appearance.UiFontSize, StringFormat='{}{0:0}'}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Code" VerticalAlignment="Center"
                                               Margin="0,0,12,0" MinWidth="70" />
                                    <Slider Grid.Column="1" VerticalAlignment="Center"
                                            Minimum="{x:Static vm:SettingsViewModel.MinFontSize}"
                                            Maximum="{x:Static vm:SettingsViewModel.MaxFontSize}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Appearance.EditorFontSize}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="28"
                                               TextAlignment="Right"
                                               Text="{Binding Appearance.EditorFontSize, StringFormat='{}{0:0}'}" />
                                </Grid>

                                <TextBlock Classes="hint"
                                           Text="Code covers the migration source, the SQL preview and the output console." />

                                <Button Content="Reset font sizes" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Appearance.ResetFontSizesCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Bound to the main view model rather than to Appearance: these are the same
                             properties the inline Wrap checkboxes on the workspace screen use, so both
                             places stay in step without a second copy of the state. -->
                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="group" Text="Source viewer" />

                                <CheckBox Content="Show line numbers" IsChecked="{Binding ShowLineNumbers}" />
                                <CheckBox Content="Wrap long lines" IsChecked="{Binding WrapSql}" />

                                <TextBlock Classes="hint"
                                           Text="Covers the migration source and the generated SQL. Wrapping is off by default because EF's SQL has meaningful indentation that wrapping breaks up; the Wrap checkbox on the Script tab is this same setting." />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="group" Text="Diagrams" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Open on" VerticalAlignment="Center" Opacity="0.7" />
                                    <ComboBox ItemsSource="{Binding DiagramKinds}"
                                              SelectedItem="{Binding DefaultDiagramKind}" MinWidth="200">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static app:OutputConverters.SpacedName}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Classes="hint"
                                           Text="Which diagram a workspace shows the first time. A workspace you have switched keeps its own choice, and the button on the Diagrams tab switches either at any time." />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="group" Text="Window" />

                                <CheckBox Content="Open as maximised window" IsChecked="{Binding OpenMaximised}" />

                                <TextBlock Classes="hint"
                                           Text="Takes effect on the next start, and follows how the window was last closed. Its size and position are remembered either way, unless the screen they were on is gone." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <Border Classes="section">
                            <StackPanel>
                                <TextBlock Classes="group" Text="dotnet-ef" />
                                <TextBlock Text="{Binding EnvironmentSummary}" Classes="label" />

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                            VerticalAlignment="Center">
                                    <Button Content="Update dotnet-ef" Command="{Binding UpdateEfToolCommand}"
                                            IsVisible="{Binding EfToolAvailable}"
                                            ToolTip.Tip="Runs dotnet tool update dotnet-ef (local install if this solution pins one, global otherwise)." />
                                    <TextBlock Text="&#x2713;" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource StateAppliedBrush}"
                                               IsVisible="{Binding EfToolUpdateSucceeded}"
                                               ToolTip.Tip="dotnet-ef update finished." />
                                </StackPanel>

                                <Button IsVisible="{Binding HasEfToolUpdateError}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Command="{Binding ShowEfToolUpdateErrorCommand}"
                                        ToolTip.Tip="Click for the full output.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="&#x2717;" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerForegroundBrush}" />
                                        <TextBlock Text="{Binding EfToolUpdateErrorSummary}"
                                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Classes="hint" Margin="0,8,0,0"
                                           Text="Output goes to the console on the workspace screen. Only available with no command already running." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Updates">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <Border Classes="section">
                            <StackPanel>
                                <TextBlock Classes="group" Text="EfAssist" />
                                <TextBlock Classes="label"
                                           Text="{Binding Update.CurrentVersion, StringFormat='Version {0}'}" />

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <!-- Left visible but disabled for a development or portable run:
                                         there is no install to update in place, and a missing button
                                         reads as a missing feature. -->
                                    <Button Content="Check for updates" Command="{Binding Update.CheckCommand}"
                                            ToolTip.Tip="Checks GitHub for a newer release. Only available in an installed build." />
                                    <Button Content="Update and restart"
                                            Classes="accent"
                                            IsVisible="{Binding Update.IsUpdateAvailable}"
                                            Command="{Binding Update.UpdateNowCommand}" />
                                </StackPanel>

                                <TextBlock Classes="hint" Margin="0,8,0,0"
                                           Text="{Binding Update.Message}"
                                           IsVisible="{Binding Update.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="hint" Margin="0,8,0,0"
                                           Text="EfAssist checks once on launch and offers anything it finds as a banner. Nothing is downloaded until you ask." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Close only: every change on this screen saves as it is made. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
