<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EfAssist.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="260"
        x:Class="EfAssist.App.Views.ConfirmWindow"
        x:DataType="vm:ConfirmRequest"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        MinHeight="180"
        CanResize="False"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

        <Border IsVisible="{Binding HasDetail}" Classes="caution" CornerRadius="4" Padding="10,8">
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeSmall}" />
        </Border>

        <StackPanel IsVisible="{Binding RequiresTyping}" Spacing="4">
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.8">
                <Run Text="Type" />
                <Run Text="{Binding RequiredTypedValue}" FontWeight="Bold" />
                <Run Text="to confirm." />
            </TextBlock>
            <TextBox Name="TypedValue" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button Name="ConfirmButton" Content="{Binding ConfirmText}" MinWidth="90" Classes="danger" />
        </StackPanel>
    </StackPanel>
</Window>
