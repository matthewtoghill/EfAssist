<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EfAssist.App.App"
             xmlns:local="using:EfAssist.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the OS. The Theme dropdown in the toolbar overrides this at
                  runtime; see App.ApplyTheme. -->

    <Application.Resources>
        <!-- Every colour the app uses beyond the Fluent defaults lives here, once, with a value per
             theme variant. Consume them with DynamicResource so a theme switch repaints live -
             StaticResource would freeze whichever variant was active at load. -->
        <ResourceDictionary>
            <!-- Font sizes, by role rather than by number. Theming.ApplyFontSizes overwrites these at
                 startup from the user's chosen base; the values here are what the XAML previewer and
                 a first run before that call see, and they match the sizes the app shipped with. -->
            <x:Double x:Key="AppFontSize">14</x:Double>
            <x:Double x:Key="AppFontSizeSmall">12</x:Double>
            <x:Double x:Key="AppFontSizeTiny">11</x:Double>
            <x:Double x:Key="AppFontSizeLarge">15</x:Double>
            <x:Double x:Key="AppFontSizeHeading">20</x:Double>
            <x:Double x:Key="AppFontSizeMono">12</x:Double>

            <StreamGeometry x:Key="folder_regular">M17.0606622,9 C17.8933043,9 18.7000032,9.27703406 19.3552116,9.78392956 L19.5300545,9.92783739 L22.116207,12.1907209 C22.306094,12.356872 22.5408581,12.4608817 22.7890575,12.4909364 L22.9393378,12.5 L40.25,12.5 C42.2542592,12.5 43.8912737,14.0723611 43.994802,16.0508414 L44,16.25 L44,35.25 C44,37.2542592 42.4276389,38.8912737 40.4491586,38.994802 L40.25,39 L7.75,39 C5.74574083,39 4.10872626,37.4276389 4.00519801,35.4491586 L4,35.25 L4,12.75 C4,10.7457408 5.57236105,9.10872626 7.55084143,9.00519801 L7.75,9 L17.0606622,9 Z M22.8474156,14.9988741 L20.7205012,17.6147223 C20.0558881,18.4327077 19.0802671,18.9305178 18.0350306,18.993257 L17.8100737,19 L6.5,18.999 L6.5,35.25 C6.5,35.8972087 6.99187466,36.4295339 7.62219476,36.4935464 L7.75,36.5 L40.25,36.5 C40.8972087,36.5 41.4295339,36.0081253 41.4935464,35.3778052 L41.5,35.25 L41.5,16.25 C41.5,15.6027913 41.0081253,15.0704661 40.3778052,15.0064536 L40.25,15 L22.8474156,14.9988741 Z M17.0606622,11.5 L7.75,11.5 C7.10279131,11.5 6.5704661,11.9918747 6.50645361,12.6221948 L6.5,12.75 L6.5,16.499 L17.8100737,16.5 C18.1394331,16.5 18.4534488,16.3701335 18.6858203,16.1419575 L18.7802162,16.0382408 L20.415,14.025 L17.883793,11.8092791 C17.693906,11.643128 17.4591419,11.5391183 17.2109425,11.5090636 L17.0606622,11.5 Z</StreamGeometry>
            <StreamGeometry x:Key="settings_regular">M14 9.50006C11.5147 9.50006 9.5 11.5148 9.5 14.0001C9.5 16.4853 11.5147 18.5001 14 18.5001C15.3488 18.5001 16.559 17.9066 17.3838 16.9666C18.0787 16.1746 18.5 15.1365 18.5 14.0001C18.5 13.5401 18.431 13.0963 18.3028 12.6784C17.7382 10.8381 16.0253 9.50006 14 9.50006ZM11 14.0001C11 12.3432 12.3431 11.0001 14 11.0001C15.6569 11.0001 17 12.3432 17 14.0001C17 15.6569 15.6569 17.0001 14 17.0001C12.3431 17.0001 11 15.6569 11 14.0001Z M21.7093 22.3948L19.9818 21.6364C19.4876 21.4197 18.9071 21.4515 18.44 21.7219C17.9729 21.9924 17.675 22.4693 17.6157 23.0066L17.408 24.8855C17.3651 25.273 17.084 25.5917 16.7055 25.682C14.9263 26.1061 13.0725 26.1061 11.2933 25.682C10.9148 25.5917 10.6336 25.273 10.5908 24.8855L10.3834 23.0093C10.3225 22.4731 10.0112 21.9976 9.54452 21.7281C9.07783 21.4586 8.51117 21.4269 8.01859 21.6424L6.29071 22.4009C5.93281 22.558 5.51493 22.4718 5.24806 22.1859C4.00474 20.8536 3.07924 19.2561 2.54122 17.5137C2.42533 17.1384 2.55922 16.7307 2.8749 16.4977L4.40219 15.3703C4.83721 15.0501 5.09414 14.5415 5.09414 14.0007C5.09414 13.4598 4.83721 12.9512 4.40162 12.6306L2.87529 11.5051C2.55914 11.272 2.42513 10.8638 2.54142 10.4882C3.08038 8.74734 4.00637 7.15163 5.24971 5.82114C5.51684 5.53528 5.93492 5.44941 6.29276 5.60691L8.01296 6.36404C8.50793 6.58168 9.07696 6.54881 9.54617 6.27415C10.0133 6.00264 10.3244 5.52527 10.3844 4.98794L10.5933 3.11017C10.637 2.71803 10.9245 2.39704 11.3089 2.31138C12.19 2.11504 13.0891 2.01071 14.0131 2.00006C14.9147 2.01047 15.8128 2.11485 16.6928 2.31149C17.077 2.39734 17.3643 2.71823 17.4079 3.11017L17.617 4.98937C17.7116 5.85221 18.4387 6.50572 19.3055 6.50663C19.5385 6.507 19.769 6.45838 19.9843 6.36294L21.7048 5.60568C22.0626 5.44818 22.4807 5.53405 22.7478 5.81991C23.9912 7.1504 24.9172 8.74611 25.4561 10.487C25.5723 10.8623 25.4386 11.2703 25.1228 11.5035L23.5978 12.6297C23.1628 12.95 22.9 13.4586 22.9 13.9994C22.9 14.5403 23.1628 15.0489 23.5988 15.3698L25.1251 16.4965C25.441 16.7296 25.5748 17.1376 25.4586 17.5131C24.9198 19.2536 23.9944 20.8492 22.7517 22.1799C22.4849 22.4657 22.0671 22.5518 21.7093 22.3948ZM16.263 22.1966C16.4982 21.4685 16.9889 20.8288 17.6884 20.4238C18.5702 19.9132 19.6536 19.8547 20.5841 20.2627L21.9281 20.8526C22.791 19.8538 23.4593 18.7013 23.8981 17.4552L22.7095 16.5778L22.7086 16.5771C21.898 15.98 21.4 15.0277 21.4 13.9994C21.4 12.9719 21.8974 12.0195 22.7073 11.4227L22.7085 11.4218L23.8957 10.545C23.4567 9.2988 22.7881 8.14636 21.9248 7.1477L20.5922 7.73425L20.5899 7.73527C20.1844 7.91463 19.7472 8.00722 19.3039 8.00663C17.6715 8.00453 16.3046 6.77431 16.1261 5.15465L16.1259 5.15291L15.9635 3.69304C15.3202 3.57328 14.6677 3.50872 14.013 3.50017C13.3389 3.50891 12.6821 3.57367 12.0377 3.69328L11.8751 5.15452C11.7625 6.16272 11.1793 7.05909 10.3019 7.56986C9.41937 8.0856 8.34453 8.14844 7.40869 7.73694L6.07273 7.14893C5.20949 8.14751 4.54092 9.29983 4.10196 10.5459L5.29181 11.4233C6.11115 12.0269 6.59414 12.9837 6.59414 14.0007C6.59414 15.0173 6.11142 15.9742 5.29237 16.5776L4.10161 17.4566C4.54002 18.7044 5.2085 19.8585 6.07205 20.8587L7.41742 20.2682C8.34745 19.8613 9.41573 19.9215 10.2947 20.4292C11.174 20.937 11.7593 21.832 11.8738 22.84L11.8744 22.8445L12.0362 24.3088C13.3326 24.5638 14.6662 24.5638 15.9626 24.3088L16.1247 22.8418C16.1491 22.6217 16.1955 22.4055 16.263 22.1966Z</StreamGeometry>
            <!-- The configured accent as a brush. Fluent exposes the accent as a Color, and Theming
                 rewrites it live from the settings screen, so this has to resolve it dynamically
                 rather than bake a literal. Anything that needs to paint with the accent outside a
                 Fluent control template uses this. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="{DynamicResource SystemAccentColor}" />

            <!-- Navigation rail glyphs. Stroke geometry in a 24x24 box, drawn with a Path rather
                 than a PathIcon: PathIcon fills, and these read as line icons. One consistent
                 style, so they scale and recolour with the rail's foreground. -->
            <StreamGeometry x:Key="nav_migrations">M4 6H20 M4 12H20 M4 18H14</StreamGeometry>
            <StreamGeometry x:Key="nav_script">M9 7L5 12L9 17 M15 7L19 12L15 17</StreamGeometry>
            <StreamGeometry x:Key="nav_diagrams">M3.5 4H10.5V9H3.5Z M13.5 15H20.5V20H13.5Z M7 9V13.5H17V15</StreamGeometry>
            <StreamGeometry x:Key="nav_tools">M14.5 4.5A4.5 4.5 0 0 0 8.6 10.4L4 15V19H8L12.6 14.4A4.5 4.5 0 0 0 18.5 8.5L15.7 11.3L13.5 9.1Z</StreamGeometry>
            <StreamGeometry x:Key="nav_output">M3.5 4.5H20.5V19.5H3.5Z M7 9L9.5 11.5L7 14 M12 14.5H17</StreamGeometry>

            <!-- Rail footer glyphs: back to the start screen, and settings. Line icons in the same
                 24x24 space as the rest of the rail. -->
            <StreamGeometry x:Key="nav_home">M4 11L12 4L20 11 M6.5 9.5V19.5H17.5V9.5</StreamGeometry>
            <StreamGeometry x:Key="nav_settings">M12 8.8A3.2 3.2 0 1 0 12 15.2A3.2 3.2 0 1 0 12 8.8Z M12 3.5V5.7 M12 18.3V20.5 M4.9 7.8L6.8 8.9 M17.2 15.1L19.1 16.2 M4.9 16.2L6.8 15.1 M17.2 8.9L19.1 7.8</StreamGeometry>

            <!-- Breadcrumb separator between the project and context pickers. -->
            <StreamGeometry x:Key="chevron_right">M4 2L8 6L4 10</StreamGeometry>

            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <!-- Structure -->
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#08000000" />
                    <!-- A card raised off a panel: the Activity list sits on the panel wash, and its
                         cards have to read as separate objects on it. -->
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SplitterGripBrush" Color="#44000000" />
                    <SolidColorBrush x:Key="SplitterGripHoverBrush" Color="#88000000" />

                    <!-- Caution: an amber wash for "this may be wrong / read this first" -->
                    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#22B87A00" />
                    <SolidColorBrush x:Key="CautionBorderBrush" Color="#55B87A00" />
                    <SolidColorBrush x:Key="CautionForegroundBrush" Color="#8A6100" />

                    <!-- Danger: destructive actions and validation failures -->
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#B33A3A" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="White" />

                    <!-- Blocker banner: nothing works, shown above everything -->
                    <SolidColorBrush x:Key="BlockerBackgroundBrush" Color="#7F1D1D" />
                    <SolidColorBrush x:Key="BlockerForegroundBrush" Color="White" />

                    <!-- Console channels -->
                    <SolidColorBrush x:Key="OutputErrorBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="OutputWarnBrush" Color="#8A6100" />
                    <SolidColorBrush x:Key="OutputMutedBrush" Color="#6E6E6E" />

                    <!-- Migration state badges -->
                    <SolidColorBrush x:Key="StateAppliedBrush" Color="#2E7D32" />
                    <SolidColorBrush x:Key="StatePendingBrush" Color="#9A6600" />
                    <SolidColorBrush x:Key="StateUnknownBrush" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="StateBadgeForegroundBrush" Color="White" />

                    <!-- Failure wash: an Activity card whose command failed, and the edge of a
                         card whose actions are destructive. -->
                    <SolidColorBrush x:Key="DiagnosisErrorBackgroundBrush" Color="#FBEAEA" />
                    <SolidColorBrush x:Key="DiagnosisErrorBorderBrush" Color="#D9A0A0" />

                    <!-- Diagram surface. Deliberately neutral rather than derived from the configured
                         accent: a diagram is read, not decorated, and an accent chosen for buttons
                         can leave node text unreadable. Resolved by role through DiagramTheme, never
                         baked into the scene — see DiagramScene.DiagramRole. -->
                    <SolidColorBrush x:Key="DiagramSurfaceBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="DiagramNodeBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DiagramNodeBorderBrush" Color="#C4C4C4" />
                    <SolidColorBrush x:Key="DiagramHeaderBackgroundBrush" Color="#EDEDED" />
                    <SolidColorBrush x:Key="DiagramHeaderTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="DiagramSubtitleTextBrush" Color="#767676" />
                    <SolidColorBrush x:Key="DiagramTextBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="DiagramMutedTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="DiagramKeyTextBrush" Color="#7A4B00" />
                    <SolidColorBrush x:Key="DiagramEdgeBrush" Color="#8C8C8C" />
                    <SolidColorBrush x:Key="DiagramEdgeLabelBrush" Color="#767676" />
                    <SolidColorBrush x:Key="DiagramHighlightBrush" Color="#1F6FEB" />
                    <SolidColorBrush x:Key="DiagramSelectionBrush" Color="#0A4FBF" />
                    <SolidColorBrush x:Key="DiagramDimmedBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="DiagramAddedBrush" Color="#1A7F37" />
                    <SolidColorBrush x:Key="DiagramRemovedBrush" Color="#CF222E" />
                    <SolidColorBrush x:Key="DiagramModifiedBrush" Color="#9A6700" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#11FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="SplitterGripBrush" Color="#55FFFFFF" />
                    <SolidColorBrush x:Key="SplitterGripHoverBrush" Color="#AAFFFFFF" />

                    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#33B87A00" />
                    <SolidColorBrush x:Key="CautionBorderBrush" Color="#66B87A00" />
                    <SolidColorBrush x:Key="CautionForegroundBrush" Color="#D1A03C" />

                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#E86C6C" />
                    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#B33A3A" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="White" />

                    <SolidColorBrush x:Key="BlockerBackgroundBrush" Color="#5A1F1F" />
                    <SolidColorBrush x:Key="BlockerForegroundBrush" Color="White" />

                    <SolidColorBrush x:Key="OutputErrorBrush" Color="#E86C6C" />
                    <SolidColorBrush x:Key="OutputWarnBrush" Color="#D9A62E" />
                    <SolidColorBrush x:Key="OutputMutedBrush" Color="#9A9A9A" />

                    <SolidColorBrush x:Key="StateAppliedBrush" Color="#3A8F3F" />
                    <SolidColorBrush x:Key="StatePendingBrush" Color="#B87A00" />
                    <SolidColorBrush x:Key="StateUnknownBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="StateBadgeForegroundBrush" Color="White" />

                    <!-- Failure wash — see the Light dictionary. -->
                    <SolidColorBrush x:Key="DiagnosisErrorBackgroundBrush" Color="#3A1F1F" />
                    <SolidColorBrush x:Key="DiagnosisErrorBorderBrush" Color="#8A3A3A" />

                    <SolidColorBrush x:Key="DiagramSurfaceBrush" Color="#141414" />
                    <SolidColorBrush x:Key="DiagramNodeBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="DiagramNodeBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="DiagramHeaderBackgroundBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="DiagramHeaderTextBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="DiagramSubtitleTextBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="DiagramTextBrush" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="DiagramMutedTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="DiagramKeyTextBrush" Color="#E0B060" />
                    <SolidColorBrush x:Key="DiagramEdgeBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="DiagramEdgeLabelBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="DiagramHighlightBrush" Color="#58A6FF" />
                    <SolidColorBrush x:Key="DiagramSelectionBrush" Color="#79B8FF" />
                    <SolidColorBrush x:Key="DiagramDimmedBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="DiagramAddedBrush" Color="#3FB950" />
                    <SolidColorBrush x:Key="DiagramRemovedBrush" Color="#F85149" />
                    <SolidColorBrush x:Key="DiagramModifiedBrush" Color="#D29922" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- AvaloniaEdit ships no default template, so the SQL viewer renders as an empty box
             without this. It follows the Fluent variant, same as everything else. -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Same story for the colour pickers on the settings screen. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- Semantic classes, app-wide so both windows share them. Colour lives in the style, not at
             the usage site, which is what makes a theme switch a one-line change. -->
        <Style Selector="Border.caution">
            <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CautionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.caution">
            <Setter Property="Foreground" Value="{DynamicResource CautionForegroundBrush}" />
        </Style>

        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
        </Style>

        <!-- Fluent's own pointerover/pressed setters would otherwise repaint a danger button with the
             ordinary accent, losing the one visual cue that it is destructive. -->
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </Application.Styles>
</Application>
