<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EfAssist.Core\EfAssist.Core.csproj" />
    <!-- The shell view model holds real logic (discovery modes, persistence) and touches no Avalonia
         type, so it is tested here rather than in a second test project. -->
    <ProjectReference Include="..\..\src\EfAssist.App\EfAssist.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real captured dotnet-ef output. The only defence against EF changing its format. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>