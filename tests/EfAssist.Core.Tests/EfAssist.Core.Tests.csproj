<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EfAssist.Core\EfAssist.Core.csproj" />
    <!-- The shell view model holds real logic (discovery modes, persistence) and touches no Avalonia
         type, so it is tested here rather than in a second test project. -->
    <ProjectReference Include="..\..\src\EfAssist.App\EfAssist.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real captured dotnet-ef output. The only defence against EF changing its format. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>